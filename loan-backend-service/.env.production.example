# Production runtime template.
# Supply every value from the approved secrets manager. Do not commit a filled copy.
# The production profile refuses the mock core banking provider and refuses the local example secrets.

SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080

DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

OPS_USERNAME=
OPS_PASSWORD=
APP_ALLOWED_ORIGINS=

JWT_HMAC_SECRET=
OTP_PEPPER=
APP_DATA_KEY=

CUSTOMER_DOCUMENT_DIR=/var/lib/lending/customer-documents
OFFER_DOCUMENT_DIR=/var/lib/lending/agreements
REPORT_EXPORT_DIR=/var/lib/lending/exports

# Leave the bootstrap values empty after the first administrator exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_MFA_SECRET=

CORE_BANKING_PROVIDER=http
CORE_BANKING_BASE_URL=
CORE_BANKING_AUTH_METHOD=
CORE_BANKING_CLIENT_ID=
CORE_BANKING_CLIENT_SECRET=
CORE_BANKING_API_KEY=
CORE_BANKING_API_KEY_HEADER=X-Api-Key
CORE_BANKING_WEBHOOK_SECRET=
CORE_BANKING_REQUEST_TIMEOUT=5s
CORE_BANKING_CONNECT_TIMEOUT=2s

API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW=1m
